    label.delete(lbl_close) 
    if show_labels
        lbl_close := label.new(time + (time_step * ny_close_offset), sessionClose, "NY-C", xloc=xloc.bar_time, yloc=yloc.price, color=color.new(color.black, 100), style=label.style_label_left, textcolor=ny_close_color, size=size.small)

//============================================================================
// CORE 2: NXS OPT (PDH & PDL ONLY)
//============================================================================
is_new_session = ta.change(time("D")) != 0

var float opt_current_high = na, var float opt_current_low = na
var float opt_pd_high = na, var float opt_pd_low = na
var int opt_pd_start_time = na

if is_new_session
    if not na(opt_current_high)
        opt_pd_high  := opt_current_high
        opt_pd_low   := opt_current_low
    opt_current_high  := high
    opt_current_low   := low
    opt_pd_start_time := time
else
    opt_current_high  := math.max(nz(opt_current_high, high), high)
    opt_current_low   := math.min(nz(opt_current_low, low), low)

var line opt_ln_pdh = na, var label opt_lbl_pdh = na
var line opt_ln_pdl = na, var label opt_lbl_pdl = na
opt_future_lvl_time = time + (time_step * opt_label_off)

if not na(opt_pd_start_time)
    line.delete(opt_ln_pdh), label.delete(opt_lbl_pdh)
    line.delete(opt_ln_pdl), label.delete(opt_lbl_pdl)

    if opt_show_pdh and not na(opt_pd_high)
        opt_ln_pdh := line.new(opt_pd_start_time, opt_pd_high, time, opt_pd_high, xloc=xloc.bar_time, color=opt_color_pdh, width=1, style=get_style(opt_line_style))
        if show_labels
            opt_lbl_pdh := label.new(opt_future_lvl_time, opt_pd_high, "PDH", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=opt_color_pdh, size=size.small)
    if opt_show_pdl and not na(opt_pd_low)
        opt_ln_pdl := line.new(opt_pd_start_time, opt_pd_low, time, opt_pd_low, xloc=xloc.bar_time, color=opt_color_pdl, width=1, style=get_style(opt_line_style))
        if show_labels
            opt_lbl_pdl := label.new(opt_future_lvl_time, opt_pd_low, "PDL", xloc=xloc.bar_time, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 100), textcolor=opt_color_pdl, size=size.small)


//============================================================================
// CORE 3: NXS SYMMETRY (PROJECTION LINES ONLY)
//============================================================================
sym_ny_h = hour(time, sym_tz)
sym_ny_m = minute(time, sym_tz)
sym_min_of_day = (sym_ny_h * 60) + sym_ny_m

sym_rth_start_mins = f_hhmm_to_mins(sym_rth_start)
sym_rth_end_mins   = f_hhmm_to_mins(sym_rth_end)
sym_on_start_mins  = f_hhmm_to_mins(sym_on_start)
sym_on_end_mins    = f_hhmm_to_mins(sym_on_end)

sym_is_in_rth = f_in_window(sym_min_of_day, sym_rth_start_mins, sym_rth_end_mins)
sym_is_in_on  = sym_use_on ? f_in_window(sym_min_of_day, sym_on_start_mins, sym_on_end_mins) : false
sym_inSession = sym_is_in_rth or sym_is_in_on

sym_chart_ticker = sym_use_eth ? ticker.modify(syminfo.tickerid, session.extended) : syminfo.tickerid
sym_chart_rth_anchor = request.security(sym_chart_ticker, "1", f_get_liquid_anchor(sym_rth_start_mins, sym_rth_end_mins, sym_tz), barmerge.gaps_off, barmerge.lookahead_on)
sym_chart_on_anchor  = request.security(sym_chart_ticker, "1", f_get_liquid_anchor(sym_on_start_mins, sym_on_end_mins, sym_tz), barmerge.gaps_off, barmerge.lookahead_on)
sym_active_chart_anchor = sym_is_in_rth ? sym_chart_rth_anchor : (sym_is_in_on ? sym_chart_on_anchor : na)

var float sym_line1_value = na
var float sym_line2_value = na

if sym_htf1_en
    sym_symbol1 = sym_htf1_sym != "" ? sym_htf1_sym : syminfo.tickerid
    sym_sym1_ticker = sym_use_eth ? ticker.modify(sym_symbol1, session.extended) : sym_symbol1
    sym_c1 = request.security(sym_sym1_ticker, sym_htf1_tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    
    sym_proj_rth1 = sym_htf1_sym != "" ? request.security(sym_sym1_ticker, "1", f_get_liquid_anchor(sym_rth_start_mins, sym_rth_end_mins, sym_tz), barmerge.gaps_off, barmerge.lookahead_on) : na
    sym_proj_on1  = sym_htf1_sym != "" ? request.security(sym_sym1_ticker, "1", f_get_liquid_anchor(sym_on_start_mins, sym_on_end_mins, sym_tz), barmerge.gaps_off, barmerge.lookahead_on) : na
    sym_active_proj1 = sym_is_in_rth ? sym_proj_rth1 : (sym_is_in_on ? sym_proj_on1 : na)
    
    sym_c1_scaled = sym_htf1_sym != "" ? scale_price(sym_c1, sym_active_proj1, sym_active_chart_anchor, sym_htf1_mult) : sym_c1
    sym_line1_value := sym_inSession ? sym_c1_scaled : na

if sym_htf2_en
    sym_symbol2 = sym_htf2_sym != "" ? sym_htf2_sym : syminfo.tickerid
    sym_sym2_ticker = sym_use_eth ? ticker.modify(sym_symbol2, session.extended) : sym_symbol2
    sym_c2 = request.security(sym_sym2_ticker, sym_htf2_tf, close, barmerge.gaps_off, barmerge.lookahead_off)
    
    sym_proj_rth2 = sym_htf2_sym != "" ? request.security(sym_sym2_ticker, "1", f_get_liquid_anchor(sym_rth_start_mins, sym_rth_end_mins, sym_tz), barmerge.gaps_off, barmerge.lookahead_on) : na
    sym_proj_on2  = sym_htf2_sym != "" ? request.security(sym_sym2_ticker, "1", f_get_liquid_anchor(sym_on_start_mins, sym_on_end_mins, sym_tz), barmerge.gaps_off, barmerge.lookahead_on) : na
    sym_active_proj2 = sym_is_in_rth ? sym_proj_rth2 : (sym_is_in_on ? sym_proj_on2 : na)
    
    sym_c2_scaled = sym_htf2_sym != "" ? scale_price(sym_c2, sym_active_proj2, sym_active_chart_anchor, sym_htf2_mult) : sym_c2
    sym_line2_value := sym_inSession ? sym_c2_scaled : na

plot(sym_htf1_en ? sym_line1_value : na, "Symmetry Slot 1", color=sym_line1_col, linewidth=sym_line_w, style=plot.style_linebr)
plot(sym_htf2_en ? sym_line2_value : na, "Symmetry Slot 2", color=sym_line2_col, linewidth=sym_line_w, style=plot.style_linebr)
