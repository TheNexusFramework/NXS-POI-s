pct_d   = prev_d != 0 ? ((curr_close - prev_d) / prev_d) * 100 : 0
pct_w   = prev_w != 0 ? ((curr_close - prev_w) / prev_w) * 100 : 0
pct_m   = prev_m != 0 ? ((curr_close - prev_m) / prev_m) * 100 : 0
pct_q   = prev_q != 0 ? ((curr_close - prev_q) / prev_q) * 100 : 0
pct_ytd = prev_ytd != 0 ? ((curr_close - prev_ytd) / prev_ytd) * 100 : 0
