//============================================================================
// HELPER FUNCTIONS
//============================================================================
get_style(s) => s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

get_spacer(n) =>
    string s = ""
    if n > 0
        for i = 1 to n
            s += "\n"
    s

f_hhmm_to_mins(hhmm_str) =>
    h = str.tonumber(str.substring(hhmm_str, 0, 2))
    m = str.tonumber(str.substring(hhmm_str, 2, 4))
    (h * 60) + m

f_in_window(mins, start_m, end_m) =>
    start_m <= end_m ? (mins >= start_m and mins < end_m) : (mins >= start_m or mins < end_m)

scale_price(proj_value, proj_anchor, chart_anchor, multiplier) =>
    if na(proj_value) or na(proj_anchor) or na(chart_anchor) or proj_anchor == 0
        na
    else
        pct_change = (proj_value - proj_anchor) / proj_anchor
        chart_anchor * (1 + (pct_change * multiplier))

f_get_liquid_anchor(start_mins, end_mins, tz) =>
    var float anchor = na
    curr_mins = (hour(time, tz) * 60) + minute(time, tz)
    in_win = start_mins <= end_mins ? (curr_mins >= start_mins and curr_mins < end_mins) : (curr_mins >= start_mins or curr_mins < end_mins)
    if in_win and not in_win[1]
        anchor := open
    anchor

